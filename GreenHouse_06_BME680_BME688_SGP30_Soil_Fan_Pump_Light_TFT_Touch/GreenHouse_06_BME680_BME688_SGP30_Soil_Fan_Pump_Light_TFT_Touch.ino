void updateDisplay() {
  if (displayTestActive && updateDisplayTest()) return;
  const unsigned long now = millis();
  if (!displayDirty && now - lastDisplayMs < DISPLAY_REFRESH_MS) return;
  lastDisplayMs = now;
  displayDirty = false;
  const int wifiStatus = CLOUD_ENABLED ? WiFi.status() : WL_DISCONNECTED;
  if (wifiStatus != lastWifiStatus) {
    lastWifiStatus = wifiStatus;
    Serial.print("Wi-Fi: ");
    Serial.println(wifiStatusText(lastWifiStatus));
    Serial.print("Configured SSID: "); Serial.println(SECRET_SSID);
    if (lastWifiStatus == WL_CONNECTED) {
      Serial.print("Wi-Fi IP: "); Serial.println(WiFi.localIP());
      Serial.print("Wi-Fi RSSI: "); Serial.println(WiFi.RSSI());
    }
  }
  String thingId = CLOUD_ENABLED && ArduinoCloud.connected() ? ArduinoCloud.getThingId() : String("");
  String deviceId = CLOUD_ENABLED ? ArduinoCloud.getDeviceId() : String("");
  // The library uses this placeholder before an ID has been obtained.
  if (thingId == "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx") thingId = "";
  if (deviceId == "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx") deviceId = "";
  if (thingId != observedThingId || deviceId != observedDeviceId) {
    observedThingId = thingId;
    observedDeviceId = deviceId;
    Serial.print("Cloud Thing ID: "); Serial.println(thingId.length() ? thingId : "(not available)");
    Serial.print("Cloud Device ID: "); Serial.println(deviceId.length() ? deviceId : "(not available)");
  }
  if (displayPageChanged) {
    carrier.display.fillScreen(DISPLAY_BACKGROUND);
    memset(previousLines, 0, sizeof(previousLines));
    carrier.display.setTextSize(DISPLAY_TEXT_SIZE);
    carrier.display.setTextColor(DISPLAY_ACCENT);
    String title = PAGE_TITLES[currentPage];
    carrier.display.setCursor((DISPLAY_WIDTH - title.length() * DISPLAY_CHAR_WIDTH) / 2, 24);
    carrier.display.print(title);
    String footer = "03< " + String(currentPage + 1) + "/" + String(PAGE_COUNT) + " >04";
    carrier.display.setCursor((DISPLAY_WIDTH - footer.length() * DISPLAY_CHAR_WIDTH) / 2, 192);
    carrier.display.print(footer);
    displayPageChanged = false;
  }
  carrier.display.setTextSize(DISPLAY_TEXT_SIZE);
  carrier.display.setTextColor(DISPLAY_FOREGROUND);
  displayRow = 0;
  switch (currentPage) {
    case 0: drawOverview(); break;
    case 1: drawBmePage(); break;
    case 2: drawBmeGasPage(); break;
    case 3: drawSecondBmePage(); break;
    case 4: drawGasPage(); break;
    case 5: drawSoilPage(); break;
    case 6: drawLightPage(); break;
    case 7: drawRgbPage(); break;
    case 8: drawCloudPage(); break;
    case 9: drawWifiPage(); break;
    case 10: drawThingIdPage(); break;
    case 11: drawDeviceIdPage(); break;
  }
  while (displayRow < DISPLAY_ROWS) displayLine("");
}


// These diagnostics report commands sent, not a successful LCD response.
void initializeDisplay() {
  const bool isRev2 = carrier.getBoardRevision() == BOARD_REVISION_2;
  Serial.print("Display: detected Carrier revision ");
  Serial.println(isRev2 ? "2" : "1");
  if (!isRev2) {
    Serial.println("Display: WARNING: this sample's relay wiring requires Carrier Rev2.");
  }
  Serial.print("Display: CS=D");
  Serial.print(isRev2 ? DISPLAY_CS_PIN : mkr_iot_carrier_rev1::TFT_CS);
  Serial.print(", DC=D");
  Serial.println(isRev2 ? DISPLAY_DC_PIN : mkr_iot_carrier_rev1::TFT_DC);

  // Restore SPI and LCD configuration after all other begin() calls.
  // Keep the revision-specific display object created by carrier.begin().
  carrier.display.init(DISPLAY_WIDTH, DISPLAY_HEIGHT);
  carrier.display.setSPISpeed(DISPLAY_SPI_HZ);
  carrier.display.enableDisplay(true);
  carrier.display.setRotation(DISPLAY_ROTATION);
  carrier.display.setTextWrap(false);
  if (isRev2) {
    digitalWrite(DISPLAY_BACKLIGHT_PIN, DISPLAY_BACKLIGHT_ON_LEVEL);
    pinMode(DISPLAY_BACKLIGHT_PIN, OUTPUT);
    Serial.print("Display: backlight D");
    Serial.print(DISPLAY_BACKLIGHT_PIN);
    Serial.print(" reads ");
    Serial.println(digitalRead(DISPLAY_BACKLIGHT_PIN) == HIGH ? "HIGH" : "LOW");
  }
  displayDirty = true;
  displayPageChanged = true;
  Serial.println("Display: initialization commands sent; visual confirmation required.");
}

void startDisplayTest() {
  displayTestActive = true;
  displayTestStartMs = millis();
  displayTestPreviousColor = -1;
  Serial.println("Display test: RED -> GREEN -> BLUE -> WHITE, then normal pages.");
}

bool updateDisplayTest() {
  const unsigned long colorIndex = (millis() - displayTestStartMs) / DISPLAY_TEST_COLOR_MS;
  if (colorIndex >= DISPLAY_TEST_COLOR_COUNT) {
    displayTestActive = false;
    displayDirty = true;
    displayPageChanged = true;
    Serial.println("Display test: complete; drawing the selected page.");
    return false;
  }
  if (displayTestPreviousColor != (int)colorIndex) {
    const uint16_t colors[DISPLAY_TEST_COLOR_COUNT] = {
      ST77XX_RED, ST77XX_GREEN, ST77XX_BLUE, ST77XX_WHITE
    };
    const char* const labels[DISPLAY_TEST_COLOR_COUNT] = {
      "RED", "GREEN", "BLUE", "WHITE"
    };
    displayTestPreviousColor = colorIndex;
    carrier.display.fillScreen(colors[colorIndex]);
    carrier.display.setTextSize(2);
    carrier.display.setTextColor(colorIndex == 2 ? ST77XX_WHITE : ST77XX_BLACK);
    carrier.display.setCursor(48, 96);
    carrier.display.print("DISPLAY TEST");
    carrier.display.setCursor(84, 126);
    carrier.display.print(labels[colorIndex]);
    Serial.print("Display test: drawing ");
    Serial.println(labels[colorIndex]);
  }
  // Sensor readings, Cloud updates and touch processing continue in loop().
  return true;
}
