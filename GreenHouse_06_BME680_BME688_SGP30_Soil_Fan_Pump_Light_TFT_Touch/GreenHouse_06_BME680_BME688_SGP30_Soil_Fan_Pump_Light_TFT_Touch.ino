void setup() {
  // Turn the relay off first; apply the initial state after carrier.begin().
  digitalWrite(LIGHT_RELAY_PIN, RELAY_OFF_LEVEL);
  pinMode(LIGHT_RELAY_PIN, OUTPUT);
  Serial.begin(SERIAL_BAUD);
  const unsigned long serialStart = millis();
  while (!Serial && millis() - serialStart < SERIAL_WAIT_MS) { }
  Serial.println("\nGreenHouse_06_BME680_BME688_SGP30_Soil_Fan_Pump_Light_TFT_Touch: manual hardware test");

  Wire.begin();
  Wire.setClock(I2C_CLOCK_HZ);
  pinMode(SOIL_PIN, INPUT);
  analogReadResolution(SOIL_ADC_BITS);

  // Initialize actuators independently of the sensors and Cloud.
  motorReady = i2cPresent(MOTOR_I2C_ADDRESS);
  if (motorReady) {
    Motor.begin(MOTOR_I2C_ADDRESS);
    Serial.begin(SERIAL_BAUD); // Motor.begin() sets the baud rate to 9600.
    Motor.speed(PUMP_MOTOR_CHANNEL, MOTOR_OFF_SPEED);
    Motor.speed(FAN_MOTOR_CHANNEL, MOTOR_OFF_SPEED);
  }
  printDevice("Motor driver", MOTOR_I2C_ADDRESS, motorReady);

  if (CARRIER_HAS_CASE) carrier.withCase();
  else carrier.noCase();
  Serial.println(carrier.begin() ? "Carrier: OK" : "Carrier: at least one module is unavailable");
  // begin() initializes the screen and buttons before checking all sensors.
  // Ensure the Rev2 backlight is on even if begin() reports a sensor failure.
  if (carrier.getBoardRevision() == BOARD_REVISION_2) {
    pinMode(DISPLAY_BACKLIGHT_PIN, OUTPUT);
    digitalWrite(DISPLAY_BACKLIGHT_PIN, DISPLAY_BACKLIGHT_ON_LEVEL);
  }
  carrier.display.setRotation(DISPLAY_ROTATION);
  carrier.display.setTextWrap(false);
  // Test the light sensor even if another Carrier module fails.
  lightReady = i2cPresent(LIGHT_I2C_ADDRESS) && carrier.Light.begin();
  printDevice("Light sensor", LIGHT_I2C_ADDRESS, lightReady);

#if ENABLE_SECOND_TH
  temperature2 = INVALID_MEASUREMENT;
  humidity2 = INVALID_MEASUREMENT;
  secondReady = carrier.getBoardRevision() == BOARD_REVISION_2 &&
                i2cPresent(CARRIER_BME_I2C_ADDRESS) && carrier.Env.begin();
  Serial.println(secondReady ? "Second T/H sensor: ready" : "Second T/H sensor: unavailable");
#endif


  pump = INITIAL_PUMP_ON;
  fan = INITIAL_FAN_ON;
  light = INITIAL_LIGHT_ON;
  temperature = INVALID_MEASUREMENT;
  humidity = INVALID_MEASUREMENT;
  lightLevel = INVALID_RAW_READING;
  soilRaw = INVALID_RAW_READING;
  eCO2 = INVALID_RAW_READING;
  tvoc = INVALID_RAW_READING;
  pressure = INVALID_MEASUREMENT;
  gasResistance = INVALID_MEASUREMENT;
  Serial.println("Initial states:");
  applyPump();
  applyFan();
  applyLight();

  // Rev2 already uses 0x76 internally. Do not attach a second driver to it.
  if (carrier.getBoardRevision() == BOARD_REVISION_2 &&
      BME_I2C_ADDRESS == CARRIER_BME_I2C_ADDRESS) {
    Serial.println("BME: address conflict! Set the external sensor solder pads to 0x77 and update the constant.");
  } else {
    bmeReady = bme.begin(I2C_CLOCK_HZ, BME_I2C_ADDRESS);
  }
  printDevice("External BME680", BME_I2C_ADDRESS, bmeReady);
  if (bmeReady) {
    bme.setOversampling(TemperatureSensor, BME_OVERSAMPLING);
    bme.setOversampling(HumiditySensor, BME_OVERSAMPLING);
    bme.setOversampling(PressureSensor, BME_OVERSAMPLING);
    bme.setIIRFilter(BME_FILTER);
    bme.setGas(BME_HEATER_C, BME_HEATER_MS);
    bme.triggerMeasurement();
  }

  sgpReady = i2cPresent(SGP30_I2C_ADDRESS) && sgp.begin(); // Includes IAQinit()
  printDevice("SGP30", SGP30_I2C_ADDRESS, sgpReady);
  if (sgpReady) Serial.println("SGP30: the first ~15 s return warm-up values (400 ppm / 0 ppb).");
  Wire.setClock(I2C_CLOCK_HZ); // Some begin() functions reconfigure Wire.
  scanI2c();
  printHelp();

  if (CLOUD_ENABLED) {
    initProperties();
    ArduinoCloud.begin(ArduinoIoTPreferredConnection);
    Wire.setClock(I2C_CLOCK_HZ); // ECCX08 Cloud authentication can leave Wire at 1 MHz.
    setDebugMessageLevel(2);
    ArduinoCloud.printDebugInfo();
    Serial.println("Cloud: connecting; hardware testing continues.");
  } else {
    Serial.println("Cloud: disabled. Use the Serial Monitor to control the hardware.");
  }
  // Reinitialize after Carrier, SD, sensors and Cloud setup have finished.
  initializeDisplay();
  if (DISPLAY_STARTUP_TEST) startDisplayTest();
  lastMeasurementMs = millis();
  Serial.println("Touch: 00 fan, 01 pump, 02 light, 03 previous page, 04 next page");
  announcePage();
  updateDisplay();
}

void loop() {
  if (CLOUD_ENABLED) {
    ArduinoCloud.update();
    Wire.setClock(I2C_CLOCK_HZ); // Restore sensor bus speed after Cloud/ECCX08 access.
    const bool connected = ArduinoCloud.connected();
    if (connected != cloudWasConnected) {
      Serial.println(connected ? "Cloud: connected" : "Cloud: disconnected");
      cloudWasConnected = connected;
    }
  }
  readTouchButtons();
  readSerialCommand();

  // Measurement timing only; no automatic actuator decisions.
  const unsigned long now = millis();
  if (now - lastMeasurementMs >= MEASUREMENT_INTERVAL_MS) {
    lastMeasurementMs = now;
    readSensors();
    printActuators();
    displayDirty = true;
  }
  updateDisplay();
}

void readSensors() {
  Serial.println("--- Sensors ---");
#if ENABLE_SECOND_TH
  readSecondTH();
#endif
  printSecondTH(); // Always reserve one row, including between sensor updates.
  // Read the SGP30 regularly, once per second.
  if (sgpReady && sgp.IAQmeasure()) {
    eCO2 = sgp.eCO2;
    tvoc = sgp.TVOC;
    Serial.print("SGP30: eCO2 = "); Serial.print(sgp.eCO2);
    Serial.print(" ppm, TVOC = "); Serial.print(sgp.TVOC); Serial.println(" ppb");
  } else {
    eCO2 = INVALID_RAW_READING;
    tvoc = INVALID_RAW_READING;
    Serial.println("SGP30: eCO2 = -- ppm, TVOC = -- ppb");
  }

  if (bmeReady && i2cPresent(BME_I2C_ADDRESS) && !bme.measuring()) {
    int32_t rawTemperature, rawHumidity, pressurePa, gasOhm;
    // false: do not wait for a measurement. This call starts the next one.
    const uint8_t gasStatus = bme.getSensorData(rawTemperature, rawHumidity,
                                               pressurePa, gasOhm, false);
    bmeGasStatus = gasStatus;
    bmeGasStatusAvailable = true;
    temperature = rawTemperature / 100.0f;
    humidity = rawHumidity / 1000.0f;
    pressure = pressurePa / 100.0f;
    gasResistance = gasOhm;
    Serial.print("BME680: temperature = "); Serial.print(temperature);
    Serial.print(" C, humidity = "); Serial.print(humidity);
    Serial.println(" %");
    Serial.print("BME680: pressure = "); Serial.print(pressure);
    Serial.print(" hPa, gas = "); Serial.print(gasOhm); Serial.println(" Ohm");
    Serial.print("BME680: gas status = 0x"); Serial.println(gasStatus, HEX);
  } else {
    temperature = INVALID_MEASUREMENT;
    humidity = INVALID_MEASUREMENT;
    pressure = INVALID_MEASUREMENT;
    gasResistance = INVALID_MEASUREMENT;
    bmeGasStatusAvailable = false;
    Serial.println("BME680: temperature = -- C, humidity = -- %");
    Serial.println("BME680: pressure = -- hPa, gas = -- Ohm");
    Serial.println("BME680: gas status = -- (no reading)");
  }

  soilRaw = analogRead(SOIL_PIN);
  Serial.print("Soil moisture: raw ADC value = "); Serial.println(soilRaw);
  readLightSensor();
}

// APDS9960 colorAvailable() starts a conversion; readColor() stops it again.
// Wait briefly for a fresh reading instead of treating "still measuring" as failure.
void readLightSensor() {
  int red, green, blue, clear;
  bool readOk = false;
  const char* error = "sensor unavailable at 0x39";
  if (lightReady && i2cPresent(LIGHT_I2C_ADDRESS)) {
    error = "measurement timeout";
    const unsigned long startedMs = millis();
    do {
      if (carrier.Light.colorAvailable()) {
        readOk = carrier.Light.readColor(red, green, blue, clear);
        error = "I2C read failed";
        break;
      }
      delay(1);
    } while (millis() - startedMs < LIGHT_READ_TIMEOUT_MS);
  }
  if (readOk) {
    lightLevel = clear;
    lightRed = red; lightGreen = green; lightBlue = blue;
    Serial.print("Light: R = "); Serial.print(red);
    Serial.print(", G = "); Serial.print(green);
    Serial.print(", B = "); Serial.print(blue);
    Serial.print(", clear = "); Serial.println(clear);
  } else {
    lightLevel = INVALID_RAW_READING;
    lightRed = lightGreen = lightBlue = INVALID_RAW_READING;
    Serial.print("Light: R/G/B/clear = --; "); Serial.println(error);
  }
}

// These three functions demonstrate the actual actuator commands.
void applyPump() {
  displayDirty = true;
  if (motorReady && i2cPresent(MOTOR_I2C_ADDRESS)) {
    Motor.speed(PUMP_MOTOR_CHANNEL, pump ? PUMP_ON_SPEED : MOTOR_OFF_SPEED);
    Serial.print("Pump: command "); Serial.println(pump ? "ON" : "OFF");
  } else {
    Serial.println("Pump: command not sent, motor driver unavailable");
  }
}

void applyFan() {
  displayDirty = true;
  if (motorReady && i2cPresent(MOTOR_I2C_ADDRESS)) {
    Motor.speed(FAN_MOTOR_CHANNEL, fan ? FAN_ON_SPEED : MOTOR_OFF_SPEED);
    Serial.print("Fan: command "); Serial.println(fan ? "ON" : "OFF");
  } else {
    Serial.println("Fan: command not sent, motor driver unavailable");
  }
}

void applyLight() {
  displayDirty = true;
  digitalWrite(LIGHT_RELAY_PIN, light ? RELAY_ON_LEVEL : RELAY_OFF_LEVEL);
  Serial.print("Light relay: command "); Serial.println(light ? "ON" : "OFF");
}

void printActuators() {
  // Requested states: the actuators provide no feedback about actual operation.
  Serial.print("Actuators (requested): pump = "); Serial.print(pump ? "ON" : "OFF");
  Serial.print(", fan = "); Serial.print(fan ? "ON" : "OFF");
  Serial.print(", light = "); Serial.println(light ? "ON" : "OFF");
}

void printHelp() {
  Serial.println("Commands: p/P = pump on/off, f/F = fan on/off, l/L = light on/off");
  Serial.println("         0 = all off, s = requested states, i = I2C scan, ? = help");
  Serial.println("         [ = previous page, ] = next page, d = display test");
}

void readSerialCommand() {
  if (!Serial.available()) return;
  const char command = Serial.read();
  if (command == '\r' || command == '\n' || command == ' ') return;
  Serial.print("Serial command: "); Serial.println(command);
  switch (command) {
    case 'p': pump = true;  applyPump();  break;
    case 'P': pump = false; applyPump();  break;
    case 'f': fan = true;   applyFan();   break;
    case 'F': fan = false;  applyFan();   break;
    case 'l': light = true;  applyLight(); break;
    case 'L': light = false; applyLight(); break;
    case '0':
      pump = false; fan = false; light = false;
      applyPump(); applyFan(); applyLight();
      break;
    case 'd': initializeDisplay(); startDisplayTest(); break;
    case '[': changePage(-1); break;
    case ']': changePage(1); break;
    case 's': printActuators(); break;
    case 'i': scanI2c(); break;
    case '?': printHelp(); break;
    default: Serial.println("Unknown command. Enter ? for help."); break;
  }
}

bool i2cPresent(uint8_t address) {
  // Also protects motor commands called from inside ArduinoCloud.update().
  Wire.setClock(I2C_CLOCK_HZ);
  Wire.beginTransmission(address);
  return Wire.endTransmission() == 0;
}

void printDevice(const char* name, uint8_t address, bool ready) {
  Serial.print(name); Serial.print(" @ 0x"); Serial.print(address, HEX);
  Serial.println(ready ? ": OK" : ": not ready (check address/wiring)");
}

void scanI2c() {
  Serial.println("I2C scan: responding addresses (does not identify sensor types)");
  uint8_t count = 0;
  for (uint8_t address = 1; address < 127; address++) {
    if (i2cPresent(address)) {
      Serial.print("  0x");
      if (address < 16) Serial.print('0');
      Serial.println(address, HEX);
      count++;
    }
  }
  Serial.print("Addresses found: "); Serial.println(count);
}

// One callback per manually controlled actuator; no sensor callbacks.
void onPumpChange() {
  Serial.println("Cloud: pump changed");
  applyPump();
}
void onFanChange() {
  Serial.println("Cloud: fan changed");
  applyFan();
}
void onLightChange() {
  Serial.println("Cloud: light changed");
  applyLight();
}

#if ENABLE_SECOND_TH
void readSecondTH() {
  if (millis() - lastSecondTHMs < SECOND_TH_INTERVAL_MS) return;
  lastSecondTHMs = millis();
  if (secondReady && i2cPresent(CARRIER_BME_I2C_ADDRESS)) {
    // The Carrier library maintains its own measurement timing and cached values.
    temperature2 = carrier.Env.readTemperature();
    humidity2 = carrier.Env.readHumidity();
  } else {
    temperature2 = INVALID_MEASUREMENT;
    humidity2 = INVALID_MEASUREMENT;
  }
}
#endif

// Print the latest cached values every cycle; reading still follows its 3 s timer.
// Missing/disabled readings occupy the same single row as valid values.
void printSecondTH() {
#if ENABLE_SECOND_TH
  Serial.print("Onboard BME688: temperature = ");
  if (isfinite(temperature2) && temperature2 != INVALID_MEASUREMENT) Serial.print(temperature2);
  else Serial.print("--");
  Serial.print(" C, humidity = ");
  if (isfinite(humidity2) && humidity2 != INVALID_MEASUREMENT) Serial.print(humidity2);
  else Serial.print("--");
  Serial.println(" %");
#else
  Serial.println("Onboard BME688: disabled");
#endif
}



// ===================== Touch and display =====================
// onTouchDown generates one action per press, not one action per loop.
void readTouchButtons() {
  carrier.Buttons.update();
  if (carrier.Buttons.onTouchDown(FAN_TOUCH)) {
    Serial.println("Touch: fan toggle");
    fan = !fan;
    applyFan();
  }
  if (carrier.Buttons.onTouchDown(PUMP_TOUCH)) {
    Serial.println("Touch: pump toggle");
    pump = !pump;
    applyPump();
  }
  if (carrier.Buttons.onTouchDown(LIGHT_TOUCH)) {
    Serial.println("Touch: light toggle");
    light = !light;
    applyLight();
  }
  if (carrier.Buttons.onTouchDown(PAGE_UP_TOUCH)) changePage(-1);
  if (carrier.Buttons.onTouchDown(PAGE_DOWN_TOUCH)) changePage(1);
}

void announcePage() {
  Serial.print("Display page ");
  Serial.print(currentPage + 1);
  Serial.print('/');
  Serial.print(PAGE_COUNT);
  Serial.print(": ");
  Serial.println(PAGE_TITLES[currentPage]);
}

void changePage(int direction) {
  currentPage = (currentPage + PAGE_COUNT + direction) % PAGE_COUNT;
  displayTestActive = false;
  displayDirty = true;
  displayPageChanged = true;
  announcePage();
}

String measurementText(float value, uint8_t decimals) {
  if (!isfinite(value) || value == INVALID_MEASUREMENT) return "--";
  return String(value, decimals);
}

String rawText(int value) {
  return value == INVALID_RAW_READING ? "--" : String(value);
}

String stateText(bool on) {
  return on ? "ON" : "OFF";
}

String addressText(uint8_t address) {
  String hex = String(address, HEX);
  hex.toUpperCase();
  return "I2C: 0x" + hex;
}

String wifiStatusText(int status) {
  switch (status) {
    case WL_CONNECTED: return "connected";
    case WL_IDLE_STATUS: return "idle";
    case WL_NO_SSID_AVAIL: return "SSID not found";
    case WL_SCAN_COMPLETED: return "scan complete";
    case WL_CONNECT_FAILED: return "connect failed";
    case WL_CONNECTION_LOST: return "connection lost";
    case WL_DISCONNECTED: return "disconnected";
    case WL_NO_MODULE: return "no Wi-Fi module";
    default: return "status " + String(status);
  }
}

String cloudStatusText() {
  if (!CLOUD_ENABLED) return "disabled";
  return ArduinoCloud.connected() ? "connected" : "offline / connecting";
}

// Draw only changed text rows; no large framebuffer and no repeated full clear.
// Seven rows of 12 x 16 pixel characters fit inside the round display.
void displayLine(String text) {
  if (displayRow >= DISPLAY_ROWS) return;
  text = text.substring(0, DISPLAY_COLUMNS);
  if (text != previousLines[displayRow]) {
    const int y = DISPLAY_Y + displayRow * DISPLAY_LINE_HEIGHT;
    carrier.display.fillRect(DISPLAY_X, y, DISPLAY_COLUMNS * DISPLAY_CHAR_WIDTH,
                             DISPLAY_LINE_HEIGHT, DISPLAY_BACKGROUND);
    carrier.display.setCursor(DISPLAY_X, y);
    carrier.display.print(text);
    text.toCharArray(previousLines[displayRow], DISPLAY_COLUMNS + 1);
  }
  displayRow++;
}

// Full IDs and SSIDs are split across rows rather than truncated.
void displayWrapped(String text) {
  if (!text.length()) text = "(not available)";
  for (unsigned int offset = 0; offset < text.length(); offset += DISPLAY_COLUMNS) {
    displayLine(text.substring(offset, offset + DISPLAY_COLUMNS));
  }
}

// Overview contains only Cloud variable values. Units and full names are on
// the detail pages; actuator values are requested states (0 = off, 1 = on).
void drawOverview() {
  displayLine("T:" + measurementText(temperature, 0) + " H:" + measurementText(humidity, 0));
#if ENABLE_SECOND_TH
  displayLine("T2:" + measurementText(temperature2, 0) + " H2:" + measurementText(humidity2, 0));
#else
  displayLine("");
#endif
  displayLine("Pr:" + measurementText(pressure, 0));
  displayLine("G:" + (gasResistance == INVALID_MEASUREMENT || !isfinite(gasResistance) ? String("--") : measurementText(gasResistance / 1000.0f, 0) + "k"));
  displayLine("C:" + rawText(eCO2) + " V:" + rawText(tvoc));
  displayLine("S:" + rawText(soilRaw) + " L:" + rawText(lightLevel));
  displayLine("F:" + String(fan ? 1 : 0) + " P:" + String(pump ? 1 : 0) + " R:" + String(light ? 1 : 0));
}

